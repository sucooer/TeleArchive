BOT_TOKEN=123456:replace-me
OWNER_TELEGRAM_USER_ID=123456789
STORAGE_ROOT=./storage
INDEX_FILE=./data/index.jsonl
LOG_FILE=./logs/bot.log
HTTP_TIMEOUT=1800
CHUNK_SIZE=1048576
MAX_CONCURRENT_DOWNLOADS=1

# Required by docker-compose.yml when running the bundled Local Bot API Server.
# Get these from https://my.telegram.org/apps.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Standalone telearchive defaults. docker-compose.yml overrides these to use
# http://telegram-bot-api:8081 for large file downloads.
BOT_API_BASE_URL=https://api.telegram.org/bot
BOT_API_BASE_FILE_URL=https://api.telegram.org/file/bot
BOT_API_LOCAL_MODE=0
